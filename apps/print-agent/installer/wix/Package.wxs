<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="SnapPrint Desktop Print Agent"
    Manufacturer="SnapPrint Technologies"
    Version="0.1.1"
    UpgradeCode="E3A7B95C-8F42-4F1A-B871-3C5E9025DF7A"
    Scope="perMachine"
    Language="1033">

    <MajorUpgrade
      Schedule="afterInstallValidate"
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="A newer version of SnapPrint Desktop Print Agent is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <CustomAction
      Id="StopRunningAgent"
      Directory="System64Folder"
      ExeCommand="taskkill.exe /F /IM snapprint-agent.exe /T"
      Execute="immediate"
      Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="StopRunningAgent" Before="InstallValidate" />
    </InstallExecuteSequence>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="SnapPrintVendorFolder" Name="SnapPrint">
        <Directory Id="INSTALLFOLDER" Name="PrintAgent" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="SnapPrint" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="AgentBinaryComponent" Guid="A4D2E5C8-1B3A-4F7E-9C2D-5E8A1B3C5E7A">
        <File
          Id="AgentExe"
          Source="$(var.SourceDir)\snapprint-agent.exe"
          KeyPath="yes">
          <Shortcut
            Id="ApplicationStartMenuShortcut"
            Directory="ApplicationProgramsFolder"
            Name="SnapPrint Desktop"
            WorkingDirectory="INSTALLFOLDER"
            Advertise="no" />
          <Shortcut
            Id="ApplicationDesktopShortcut"
            Directory="DesktopFolder"
            Name="SnapPrint Desktop"
            WorkingDirectory="INSTALLFOLDER"
            Advertise="no" />
        </File>
      </Component>
      <Component Id="AgentStartupRegistryComponent" Guid="C6F4A8E1-3D5B-4C9A-8E2F-7A1B3C5D7E9F" Directory="INSTALLFOLDER">
        <RegistryValue
          Root="HKLM"
          Key="Software\Microsoft\Windows\CurrentVersion\Run"
          Name="SnapPrintAgent"
          Value="&quot;[INSTALLFOLDER]snapprint-agent.exe&quot; start"
          Type="string"
          KeyPath="yes" />
      </Component>
      <Component Id="ApplicationShortcutsComponent" Guid="B5E3F6D9-2C4B-5E8F-0D3E-6F9B2C4D6E8B" Directory="ApplicationProgramsFolder">
        <Shortcut
          Id="UninstallProductShortcut"
          Name="Uninstall SnapPrint Desktop Print Agent"
          Description="Uninstalls SnapPrint Desktop Print Agent"
          Target="[System64Folder]msiexec.exe"
          Arguments="/x [ProductCode]" />
        <RemoveFolder Id="CleanUpApplicationProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue
          Root="HKLM"
          Key="Software\SnapPrint\SnapPrintAgent"
          Name="installed"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="MainFeature" Title="SnapPrint Desktop Print Agent" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>
  </Package>
</Wix>