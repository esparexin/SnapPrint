{
  "name": "@snapprint/root",
  "private": true,
  "description": "SnapPrint — multi-tenant photo printing shop SaaS (engineering foundation)",
  "version": "0.1.0",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "clean": "tsx scripts/clean.ts",
    "build": "tsx scripts/clean.ts && pnpm -r run build",
    "start": "pnpm --filter api start",
    "start:api": "pnpm --filter api start",
    "start:web": "pnpm --filter web start",
    "test": "vitest run",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check:file-sizes": "tsx scripts/check-file-sizes.ts",
    "check:architecture": "tsx scripts/check-architecture-boundaries.ts",
    "check:governance": "tsx scripts/check-architecture-boundaries.ts",
    "security:audit": "pnpm audit --audit-level=high --prod",
    "admin:provision": "tsx apps/api/src/cli/provision-platform-admin.ts",
    "agent:pair": "pnpm --filter @snapprint/print-agent start enroll",
    "agent:start": "pnpm --filter @snapprint/print-agent start start"
  },
  "devDependencies": {
    "typescript": "~5.8.0",
    "eslint": "~9.15.0",
    "@eslint/js": "~9.15.0",
    "typescript-eslint": "~8.15.0",
    "prettier": "~3.4.0",
    "vitest": "~3.0.0",
    "tsx": "~4.19.0"
  }
}
