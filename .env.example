# SnapPrint Environment Template
# Copy this file to .env (or apps/api/.env) and populate with your environment values.
# NEVER commit real secrets or production credentials to version control.

# -----------------------------------------------------------------------------
# 1. Core Server Configuration (apps/api)
# -----------------------------------------------------------------------------
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# 2. Frontend Client Configuration (apps/web)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL: Base URL of the Fastify API backend.
# In development, leave blank or set to http://localhost:3001.
# In production, set to your publicly accessible backend domain (e.g. https://api.snapprint.example.com).
NEXT_PUBLIC_API_URL="http://localhost:3001"

# -----------------------------------------------------------------------------
# 3. MongoDB Atlas Persistence
# -----------------------------------------------------------------------------
# Standard connection URI with retryWrites and w=majority.
# Replace placeholders with your MongoDB cluster credentials.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority"
MONGODB_DB_NAME="snapprint"

# -----------------------------------------------------------------------------
# 4. Authentication & Cryptographic Keys
# -----------------------------------------------------------------------------
# SESSION_SECRET: Minimum 32 characters (prefer 64 hex characters / 256 bits).
# Used for HMAC-SHA256 signing of customer QR session tokens.
SESSION_SECRET="generate-with-node-crypto-randombytes-32-hex-min-32-chars"

# COOKIE_SECRET: Minimum 32 characters (prefer 64 hex characters / 256 bits).
# Used for signing server-side operator session cookies.
COOKIE_SECRET="generate-with-node-crypto-randombytes-32-hex-min-32-chars"

# -----------------------------------------------------------------------------
# 5. CORS & Network Boundaries
# -----------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# TRUST_PROXY: Set to true or specify trusted proxy CIDRs when running behind
# reverse proxies (Render, Cloudflare, AWS ALB) so client IP rate-limiting functions.
# Set to false for direct local connections.
TRUST_PROXY="false"

# COOKIE_SECURE: Set to true in production to mandate HTTPS-only transmission.
COOKIE_SECURE="false"

# -----------------------------------------------------------------------------
# 6. Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW="1 minute"
OTP_TTL_MINUTES=15

# -----------------------------------------------------------------------------
# 7. Payment Gateway Integration (Razorpay)
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# -----------------------------------------------------------------------------
# 8. Transactional Email (ZeptoMail)
# -----------------------------------------------------------------------------
# A real ZeptoMail API token and verified sender are required to run the API.
ZEPTOMAIL_API_TOKEN="your_zeptomail_api_token"
ZEPTOMAIL_FROM_EMAIL="verified-sender@example.com"
ZEPTOMAIL_FROM_NAME="SnapPrint"
# Optional: ZEPTOMAIL_BOUNCE_ADDRESS="bounces@example.com"

# -----------------------------------------------------------------------------
# 9. Media Storage (Cloudinary)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
# Optional: CLOUDINARY_URL="cloudinary://your_api_key:your_api_secret@your_cloud_name"
CLOUDINARY_FOLDER="SnapPrint"

# -----------------------------------------------------------------------------
# 10. MSG91 Transactional Email & OTP
# -----------------------------------------------------------------------------
MSG91_AUTHKEY="your_msg91_authkey"
MSG91_EMAIL_DOMAIN="snap.palnadu.dev"
MSG91_EMAIL_FROM="otp@snap.palnadu.dev"
MSG91_EMAIL_TEMPLATE_ID="snap_otp"


