# SnapPrint Environment Variables Template
# Copy this file to .env or apps/api/.env and fill in the values.
# DO NOT commit real secrets to version control.

PORT=3001
HOST=127.0.0.1
NODE_ENV=development

# MongoDB Atlas Database
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority"
MONGODB_DB_NAME="snapprint"

# Auth & Sessions
SESSION_SECRET="dev-insecure-session-secret-must-be-at-least-32-chars-long!"
